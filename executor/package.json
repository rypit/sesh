{
  "name": "sesh-executor",
  "private": true,
  "description": "sesh's untrusted script executor: the Code Mode runtime in workerd, with connector stubs that forward every call to the gateway (ADR 0004).",
  "license": "Apache-2.0",
  "scripts": {
    "build": "esbuild src/host.js --bundle --format=esm --platform=neutral --main-fields=module,main --conditions=workerd,worker,import --external:cloudflare:* --external:node:* --outfile=dist/host.js"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.6"
  },
  "devDependencies": {
    "esbuild": "0.27.4",
    "workerd": "1.20261125.1"
  }
}
